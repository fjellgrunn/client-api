{
  "name": "@fjell/client-api",
  "description": "Client API for Fjell",
  "version": "4.4.74",
  "keywords": [
    "client",
    "api",
    "fjell"
  ],
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "browser": "./dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"tsc --noEmit --watch\" \"node build.js --watch\"",
    "build": "npm run lint && tsc --noEmit && node build.js",
    "lint": "eslint . --ext .ts --fix",
    "clean": "rm -rf dist",
    "test": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "precommit": "npm run clean && npm run lint && npm run build && npm run test",
    "prepublishOnly": "npm run clean && npm run build",
    "docs:dev": "cd docs && npm run dev",
    "docs:build": "cd docs && npm run build",
    "docs:preview": "cd docs && npm run preview",
    "docs:test": "cd docs && npm run test"
  },
  "dependencies": {
    "@fjell/core": "^4.4.80",
    "@fjell/http-api": "^4.4.70",
    "@fjell/logging": "^4.4.73",
    "@fjell/registry": "^4.4.87",
    "@fjell/types": "^4.4.10",
    "@fjell/validation": "^4.4.7",
    "deepmerge": "^4.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.39.4",
    "@fjell/common-config": "^1.1.41",
    "@tsconfig/recommended": "^1.0.13",
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "concurrently": "^9.2.1",
    "esbuild": "0.28.1",
    "eslint": "^9.39.4",
    "jsdom": "^27.4.0",
    "prismjs": ">=1.30.0",
    "typescript": "^5.9.3",
    "undici": "^7.28.0",
    "vitest": "^4.1.10",
    "vitest-fetch-mock": "^0.4.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fjellgrunn/client-api.git"
  },
  "bugs": {
    "url": "https://github.com/fjellgrunn/client-api/issues"
  },
  "homepage": "https://github.com/fjellgrunn/client-api#readme",
  "author": "Fjell Team",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "guide"
  ],
  "overrides": {
    "esbuild": "0.28.1"
  }
}
